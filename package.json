{
  "name": "whatsapp-order-bot",
  "version": "1.0.0",
  "description": "Production-ready WhatsApp ordering bot with REST API and admin dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "seed": "node scripts/seed.js",
    "lint": "eslint src/**/*.js server.js",
    "test": "jest --runInBand",
    "docker:build": "docker build -t whatsapp-order-bot .",
    "docker:run": "docker-compose up -d"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "qrcode-terminal": "^0.12.0",
    "uuid": "^9.0.0",
    "whatsapp-web.js": "^1.23.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "axios": "^1.6.2",
    "node-cache": "^5.1.2",
    "puppeteer": "^21.6.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "ordering",
    "saas",
    "nodejs",
    "mongodb"
  ],
  "author": "WhatsApp Order Bot",
  "license": "MIT"
}
